{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trlavanda-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "trl-api",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "trlavanda-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "http.server",
        "8600",
        "--directory",
        "web"
      ],
      "port": 8600
    }
  ]
}
