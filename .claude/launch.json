{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trlavanda-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "http.server",
        "8600",
        "--directory",
        "web"
      ],
      "port": 8600
    },
    {
      "name": "trlavanda-gateway-local",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./services/gateway/cmd/gateway",
        "-local",
        "data",
        "-addr",
        "127.0.0.1:8000"
      ],
      "port": 8000
    }
  ]
}
