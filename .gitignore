.venv/
.env

# Datos descargados (se regeneran con el pipeline; no se suben a GitHub)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Notebooks
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db

# Datos de la web (se generan con trl-web y se publican en la rama gh-pages)
web/data/

# Estado local de la ingesta incremental
data/state.json
